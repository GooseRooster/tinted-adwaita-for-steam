/* {{scheme.name}} by {{scheme.author}} */
/* tinted-adwaita-for-steam — https://github.com/GooseRooster/tinted-adwaita-for-steam */

:root
{
	--adw-color-scheme: {{variant}} !important;

	/* --- Accent / semantic --- */
	--adw-accent-bg-light: #{{ui.accent.normal.hex}} !important;
	--adw-accent-bg-dark: #{{ui.accent.normal.hex}} !important;
	--adw-accent-fg: #{{ui.global.background.normal.hex}} !important;

	--adw-destructive-bg-light: #{{palette.red.normal.hex}} !important;
	--adw-destructive-bg-dark: #{{palette.red.normal.hex}} !important;
	--adw-destructive-fg: #{{ui.global.background.normal.hex}} !important;

	--adw-success-bg-light: #{{palette.green.normal.hex}} !important;
	--adw-success-bg-dark: #{{palette.green.normal.hex}} !important;
	--adw-success-fg: #{{ui.global.background.normal.hex}} !important;

	--adw-warning-bg-light: #{{palette.yellow.normal.hex}} !important;
	--adw-warning-bg-dark: #{{palette.yellow.normal.hex}} !important;
	--adw-warning-fg: #{{ui.global.background.normal.hex}} !important;

	--adw-error-bg-light: #{{palette.red.normal.hex}} !important;
	--adw-error-bg-dark: #{{palette.red.normal.hex}} !important;
	--adw-error-fg: #{{ui.global.background.normal.hex}} !important;

	/* --- Window / surfaces --- */
	--adw-window-bg: #{{ui.global.background.normal.hex}} !important;
	--adw-window-fg: #{{ui.global.foreground.normal.hex}} !important;

	--adw-view-bg: #{{ui.global.background.normal.hex}} !important;
	--adw-view-fg: #{{ui.global.foreground.normal.hex}} !important;

	--adw-headerbar-bg: #{{ui.chrome.background.dark.hex}} !important;
	--adw-headerbar-fg: #{{ui.global.foreground.normal.hex}} !important;
	--adw-headerbar-backdrop: #{{ui.global.background.normal.hex}} !important;
	--adw-headerbar-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.36) !important;
	--adw-headerbar-darker-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.9) !important;

	--adw-sidebar-bg: #{{ui.chrome.background.dark.hex}} !important;
	--adw-sidebar-fg: #{{ui.global.foreground.normal.hex}} !important;
	--adw-sidebar-backdrop: #{{ui.global.background.normal.hex}} !important;
	--adw-sidebar-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.25) !important;
	--adw-sidebar-border: #{{ui.border.normal.hex}} !important;

	--adw-secondary-sidebar-bg: #{{ui.chrome.background.normal.hex}} !important;
	--adw-secondary-sidebar-fg: #{{ui.global.foreground.normal.hex}} !important;
	--adw-secondary-sidebar-backdrop: #{{ui.chrome.background.dark.hex}} !important;
	--adw-secondary-sidebar-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.25) !important;
	--adw-secondary-sidebar-border: #{{ui.border.normal.hex}} !important;

	--adw-card-bg: #{{ui.chrome.background.normal.hex}} !important;
	--adw-card-fg: #{{ui.global.foreground.normal.hex}} !important;
	--adw-card-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.36) !important;

	--adw-dialog-bg: #{{ui.chrome.background.normal.hex}} !important;
	--adw-dialog-fg: #{{ui.global.foreground.normal.hex}} !important;

	--adw-popover-bg: #{{ui.chrome.background.normal.hex}} !important;
	--adw-popover-fg: #{{ui.global.foreground.normal.hex}} !important;
	--adw-popover-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.25) !important;

	--adw-thumbnail-bg: #{{ui.chrome.background.normal.hex}} !important;
	--adw-thumbnail-fg: #{{ui.global.foreground.normal.hex}} !important;

	--adw-shade: rgba({{ui.border.normal.rgb.r}}, {{ui.border.normal.rgb.g}}, {{ui.border.normal.rgb.b}}, 0.25) !important;
	--adw-banner: #{{palette.gray.normal.hex}} !important;

	/* --- Presence --- */
	--adw-user-offline: #{{palette.gray.normal.hex}} !important;
	--adw-user-online: #{{ui.accent.normal.hex}} !important;
	--adw-user-ingame: #{{palette.green.normal.hex}} !important;

	/* --- Accent palette --- */
	--adw-accent-blue: #{{palette.blue.normal.hex}} !important;
	--adw-accent-teal: #{{palette.cyan.normal.hex}} !important;
	--adw-accent-green: #{{palette.green.normal.hex}} !important;
	--adw-accent-yellow: #{{palette.yellow.normal.hex}} !important;
	--adw-accent-orange: #{{palette.orange.normal.hex}} !important;
	--adw-accent-red: #{{palette.red.normal.hex}} !important;
	--adw-accent-pink: #{{palette.magenta.normal.hex}} !important;
	--adw-accent-purple: #{{palette.magenta.normal.hex}} !important;
	--adw-accent-slate: #{{palette.gray.normal.hex}} !important;
}
