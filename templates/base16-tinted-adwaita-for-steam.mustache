/* {{scheme-name}} by {{scheme-author}} */
/* tinted-adwaita-for-steam — https://github.com/GooseRooster/tinted-adwaita-for-steam */

:root
{
	--adw-color-scheme: {{#scheme-is-dark-variant}}dark{{/scheme-is-dark-variant}}{{^scheme-is-dark-variant}}light{{/scheme-is-dark-variant}} !important;

	/* --- Accent / semantic --- */
	--adw-accent-bg-light: #{{base0D-hex}} !important;
	--adw-accent-bg-dark: #{{base0D-hex}} !important;
	--adw-accent-fg: #{{base00-hex}} !important;

	--adw-destructive-bg-light: #{{base08-hex}} !important;
	--adw-destructive-bg-dark: #{{base08-hex}} !important;
	--adw-destructive-fg: #{{base00-hex}} !important;

	--adw-success-bg-light: #{{base0B-hex}} !important;
	--adw-success-bg-dark: #{{base0B-hex}} !important;
	--adw-success-fg: #{{base00-hex}} !important;

	--adw-warning-bg-light: #{{base0A-hex}} !important;
	--adw-warning-bg-dark: #{{base0A-hex}} !important;
	--adw-warning-fg: #{{base00-hex}} !important;

	--adw-error-bg-light: #{{base08-hex}} !important;
	--adw-error-bg-dark: #{{base08-hex}} !important;
	--adw-error-fg: #{{base00-hex}} !important;

	/* --- Window / surfaces --- */
	--adw-window-bg: #{{base00-hex}} !important;
	--adw-window-fg: #{{base05-hex}} !important;

	--adw-view-bg: #{{base00-hex}} !important;
	--adw-view-fg: #{{base05-hex}} !important;

	--adw-headerbar-bg: #{{base01-hex}} !important;
	--adw-headerbar-fg: #{{base05-hex}} !important;
	--adw-headerbar-backdrop: #{{base00-hex}} !important;
	--adw-headerbar-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.36) !important;
	--adw-headerbar-darker-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.9) !important;

	--adw-sidebar-bg: #{{base01-hex}} !important;
	--adw-sidebar-fg: #{{base05-hex}} !important;
	--adw-sidebar-backdrop: #{{base00-hex}} !important;
	--adw-sidebar-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.25) !important;
	--adw-sidebar-border: #{{base03-hex}} !important;

	--adw-secondary-sidebar-bg: #{{base02-hex}} !important;
	--adw-secondary-sidebar-fg: #{{base05-hex}} !important;
	--adw-secondary-sidebar-backdrop: #{{base01-hex}} !important;
	--adw-secondary-sidebar-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.25) !important;
	--adw-secondary-sidebar-border: #{{base03-hex}} !important;

	--adw-card-bg: #{{base02-hex}} !important;
	--adw-card-fg: #{{base05-hex}} !important;
	--adw-card-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.36) !important;

	--adw-dialog-bg: #{{base02-hex}} !important;
	--adw-dialog-fg: #{{base05-hex}} !important;

	--adw-popover-bg: #{{base02-hex}} !important;
	--adw-popover-fg: #{{base05-hex}} !important;
	--adw-popover-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.25) !important;

	--adw-thumbnail-bg: #{{base02-hex}} !important;
	--adw-thumbnail-fg: #{{base05-hex}} !important;

	--adw-shade: rgba({{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}}, 0.25) !important;
	--adw-banner: #{{base03-hex}} !important;

	/* --- Presence --- */
	--adw-user-offline: #{{base03-hex}} !important;
	--adw-user-online: #{{base0D-hex}} !important;
	--adw-user-ingame: #{{base0B-hex}} !important;

	/* --- Accent palette --- */
	--adw-accent-blue: #{{base0D-hex}} !important;
	--adw-accent-teal: #{{base0C-hex}} !important;
	--adw-accent-green: #{{base0B-hex}} !important;
	--adw-accent-yellow: #{{base0A-hex}} !important;
	--adw-accent-orange: #{{base09-hex}} !important;
	--adw-accent-red: #{{base08-hex}} !important;
	--adw-accent-pink: #{{base0E-hex}} !important;
	--adw-accent-purple: #{{base0E-hex}} !important;
	--adw-accent-slate: #{{base03-hex}} !important;
}
